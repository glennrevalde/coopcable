# Apache settings (XAMPP / WAMP / shared hosting). For nginx, see README.md.
Options -Indexes
DirectoryIndex index.php

# Only index.php, login.php, register.php, platform.php, assets/, the customer portal (portal/) and the payment
# gateway webhook (api/gateway.php) are meant to be opened from a browser or by the gateway. The patterns are anchored
# at this folder: the program's own folders are closed.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|config|cron|database|modules|storage|tests|tools|views|docs)(/|$) - [F,L]
    RewriteRule ^portal/views(/|$) - [F,L]
    RewriteRule (^|/)\.(?!well-known) - [F,L]
</IfModule>

<FilesMatch "\.(sql|md|log|ini|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
</IfModule>

# The CSV / Excel imports accept files up to 50 MB; PHP's own defaults (2 MB upload, 8 MB post) would refuse them
# (XAMPP already allows 40 MB). Applied only where PHP
# runs as an Apache module; with PHP-FPM / CGI the .user.ini file next to this one does the same.
<IfModule mod_php.c>
    php_value upload_max_filesize 60M
    php_value post_max_size 64M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 60M
    php_value post_max_size 64M
</IfModule>
